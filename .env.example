# ==========================================
# UNIFIED ENVIRONMENT CONFIGURATION (.env)
# ==========================================

# --- Frontend Settings ---
# Points to Vercel's serverless function endpoints
VITE_API_BASE_URL=/api

# --- Backend Settings ---
NODE_ENV=production
PORT=5000
JWT_SECRET=generate_a_long_random_alphanumeric_string

# --- MongoDB Connection ---
# Replace with your MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority

# --- Admin Credentials (Seeding) ---
# Seeded automatically if the DB is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- SMTP / Gmail 2FA & Alerts Settings ---
EMAIL_SERVICE=gmail
EMAIL_USER=your_smtp_sender_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_TO=your_destination_inbox@gmail.com
