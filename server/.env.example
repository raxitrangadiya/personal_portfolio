# Server Configuration
PORT=5000
JWT_SECRET=supersecretkey_change_this_in_production

# MongoDB Connection
# Replace with your MongoDB Atlas Connection URI or keep local
MONGODB_URI=mongodb://localhost:27017/portfolio

# Admin Credentials (Set your desired username and password here)
# The server will automatically seed this account on startup if the database is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Email Notifications Configuration (Optional)
# If filled, the server will email you copy of the contact messages
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_TO=your_destination_email@gmail.com
